# Submarine sync server — settings for Docker Compose.
# Copy to .env, or run ./setup.sh, which does that and fills in the secrets.
# Keep .env private: it holds the database password and the token pepper.

# --- Secrets (./setup.sh makes random ones) --------------------------------
SUBMARINE_DB_PASSWORD=
MARIADB_ROOT_PASSWORD=
# Mixed into every stored token hash. Never change it afterwards: that signs
# everybody out.
SUBMARINE_TOKEN_PEPPER=

# --- HTTPS (docker compose --profile https up -d) ---------------------------
# A domain name that points at this machine, e.g. sync.example.com.
SUBMARINE_DOMAIN=
# The proxy in front of the app, whose X-Forwarded-For is believed.
SUBMARINE_TRUSTED_PROXIES=caddy

# --- Who can make an account -------------------------------------------------
# invite: people you invite (docker compose exec app php bin/admin.php invite <email>)
# open:   anyone, with a code by mail (needs the mail settings below)
SUBMARINE_SIGNUP=invite
# Most accounts the server holds (0: no limit).
SUBMARINE_MAX_ACCOUNTS=0

# --- Mail (only needed for SUBMARINE_SIGNUP=open and "forgot password" by mail)
# off or smtp
SUBMARINE_MAIL_TRANSPORT=off
SUBMARINE_MAIL_FROM=
SUBMARINE_MAIL_FROM_NAME=Submarine sync
SUBMARINE_SMTP_HOST=
SUBMARINE_SMTP_PORT=587
# starttls (587), tls (465), or none (a relay on this machine or network only)
SUBMARINE_SMTP_SECURITY=starttls
SUBMARINE_SMTP_USER=
SUBMARINE_SMTP_PASSWORD=
# Check the mail server's certificate (empty: yes).
SUBMARINE_SMTP_VERIFY_PEER=
# The most mails sent in an hour (empty: 200).
SUBMARINE_MAIL_PER_HOUR=

# --- Web admin panel (off while the hash is empty) ---------------------------
# Make the hash with:  docker compose run --rm app php bin/admin.php hash-password
# and paste the line it prints, with its single quotes.
SUBMARINE_ADMIN_PASSWORD_HASH=
SUBMARINE_ADMIN_PATH=/admin
# 1: a browser on this machine may open the panel over plain http (http://localhost:8080/admin).
SUBMARINE_ADMIN_ALLOW_HTTP_LOCAL=

# --- Other -------------------------------------------------------------------
# Storage per account, in MB, and the other caps per account (empty: 20000, 100, 50).
SUBMARINE_QUOTA_MB=5
SUBMARINE_QUOTA_RECORDS=
SUBMARINE_QUOTA_PROFILES=
SUBMARINE_QUOTA_SHARES=
# How long a device stays signed in, in days (empty: 90).
SUBMARINE_TOKEN_TTL_DAYS=
# Setting up a sharing key the first time takes the account password (empty: no; see README, Security).
SUBMARINE_KEYS_NEED_PASSWORD=
# Failed sign-ins are answered at this many ms (see php bin/admin.php check).
SUBMARINE_LOGIN_FLOOR_MS=1000
# Where the app container listens on this machine (127.0.0.1: this machine only).
SUBMARINE_HTTP_BIND=127.0.0.1
SUBMARINE_HTTP_PORT=8080
# A path in front of every address, e.g. /submarine (empty: none).
SUBMARINE_BASE_PATH=
